{
  "name": "olivelog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:vercel": "node scripts/vercel-build.mjs",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx --env-file=.env.local prisma/scripts/seed.ts",
    "db:seed:cleanup": "tsx --env-file=.env.local prisma/scripts/seed-cleanup.ts",
    "db:backfill:coordinates": "tsx --env-file=.env.local prisma/scripts/backfill-farm-coordinates.ts",
    "db:backfill:coordinates:write": "tsx --env-file=.env.local prisma/scripts/backfill-farm-coordinates.ts --write",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/stripe/webhook"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.39.3",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@mapbox/mapbox-gl-geocoder": "^5.0.3",
    "@prisma/client": "^5.22.0",
    "@stripe/stripe-js": "^9.5.0",
    "@types/react-map-gl": "^6.1.7",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.294.0",
    "mapbox-gl": "^3.12.0",
    "next": "15.5.23",
    "openai": "^6.15.0",
    "papaparse": "^5.5.3",
    "prisma": "^5.22.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-map-gl": "^7.1.7",
    "recharts": "^3.6.0",
    "stripe": "^22.1.1",
    "tailwind-merge": "^2.2.0",
    "tailwindcss-animate": "^1.0.7",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/mapbox__mapbox-gl-geocoder": "^5.0.0",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^20.10.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.56.0",
    "eslint-config-next": "15.5.23",
    "jsdom": "^27.4.0",
    "postcss": "^8.4.32",
    "prettier": "^3.1.1",
    "tailwindcss": "^3.3.6",
    "tsx": "^4.19.4",
    "typescript": "^5.3.3",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "serialize-javascript": "7.0.5",
    "glob@^10.3.10": "10.5.0",
    "minimatch@^9.0.1": "9.0.9"
  }
}
