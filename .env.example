# Database (Neon PostgreSQL)
# IMPORTANT for serverless deploys (Vercel): use Neon's pooled connection string
# (the host that contains "-pooler") and add `pgbouncer=true&connection_limit=1`
# to avoid exhausting Postgres connections under load.
# Example:
#   postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/olivelog?sslmode=require&pgbouncer=true&connection_limit=1
DATABASE_URL=postgresql://username:password@host:5432/olivelog?sslmode=require

# Clerk Authentication
# Production must use a Clerk *production* instance (pk_live_ / sk_live_).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# Leave NEXT_PUBLIC_CLERK_IS_SATELLITE unset. oliveiq.gr already 308s the apex
# to www, so there is no second domain needing its own Clerk instance. If it is
# ever set, NEXT_PUBLIC_CLERK_SIGN_IN_URL must be an absolute URL.
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Mapbox (for maps and location features)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.eyJ1...

# Optional: Meta Pixel for consent-based ad attribution
# Create a Pixel in Meta Events Manager and use its numeric Pixel ID.
# NEXT_PUBLIC_META_PIXEL_ID=123456789012345

# Optional: OpenWeatherMap API (for weather intelligence)
# Get your free API key at: https://openweathermap.org/api
# OPENWEATHER_API_KEY=your_api_key_here

# Vercel Cron Security
# Generate a random secret for cron job authentication
# You can generate one with: openssl rand -base64 32
CRON_SECRET=your_cron_secret_here

# Optional: OpenAI API (for AI Geoponos insights)
# Get your API key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# Optional: override default models. Defaults shown.
# OPENAI_MODEL=gpt-4o-mini

# Optional: monthly per-user token budget (hard cap across all AI endpoints).
# Defaults to 500000 tokens / user / calendar month.
# OPENAI_MONTHLY_TOKEN_BUDGET=500000

# Upstash Redis REST credentials enable distributed rate limiting across
# Vercel function instances. Optional locally; required for protected
# production routes, which fail closed when the limiter is unavailable.
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxx

# Web Push (δάκος risk alerts). Generate once with:
#   npx web-push generate-vapid-keys
# Leave unset to disable push (alerts become a silent no-op).
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=BPxxxx...
# VAPID_PRIVATE_KEY=xxxxx
# VAPID_SUBJECT=mailto:hello@oliveiq.gr

# Stripe Billing (https://dashboard.stripe.com/apikeys)
# Use real keys — placeholders with "..." are rejected by isStripeSecretKeyConfigured().
# Local webhooks: run `npm run stripe:listen`, copy whsec_ from output, restart dev server.
# See docs/STRIPE.md for full setup (Vercel webhooks, production cutover).
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_FROM_DASHBOARD
STRIPE_WEBHOOK_SECRET=whsec_FROM_STRIPE_LISTEN_OR_DASHBOARD_WEBHOOK

# Stripe Price IDs — single paid tier (Pro/GROWER), annual-first.
# Create two prices on the same product in the Stripe Dashboard:
#   - recurring yearly  (EUR 49/yr)  -> STRIPE_PRICE_GROWER_ANNUAL
#   - recurring monthly (EUR 6/mo)   -> STRIPE_PRICE_GROWER
# Checkout defaults to annual and falls back to monthly if annual is unset.
STRIPE_PRICE_GROWER=price_xxx_monthly
STRIPE_PRICE_GROWER_ANNUAL=price_xxx_annual
